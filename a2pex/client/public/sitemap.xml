<?xml version="1.0" encoding="UTF-8"?>
<!--
  Static shell only. Product URLs (/product/:slug) are added dynamically as
  kits are created, so they can't be listed here ahead of time — generate
  those server-side (e.g. a small /sitemap-products.xml route reading from
  the products table) once the catalog is live, and reference it below.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>/</loc><changefreq>daily</changefreq><priority>1.0</priority></url>
  <url><loc>/shop</loc><changefreq>daily</changefreq><priority>0.9</priority></url>
</urlset>
