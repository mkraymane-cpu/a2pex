# Server
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MySQL Database
# On Vercel, set DB_HOST to the resolved IPv4 of your Aiven host (DNS
# resolution for the Aiven hostname can fail from Vercel's network even
# though it works everywhere else). DB_SSL_SERVERNAME carries the real
# hostname through to the TLS handshake (SNI), which Aiven needs to route
# the connection correctly — leave it unset for plain local/Docker MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=a2pex
DB_SSL_SERVERNAME=

# JWT Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary (image storage) — free tier, no credit card required.
# Get these 3 values from your Cloudinary dashboard after signup.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upload limits
MAX_UPLOAD_SIZE_MB=5

# Only used when running server.js directly (local dev / traditional
# hosting). Not read on Vercel, which assigns its own port internally.
PORT=5000
